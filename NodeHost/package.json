    "dbus-next": "^0.10.2",
    "dotenv": "^16.4.7"
  },
  "bin": "src/app.js",
  "devDependencies": {
    "patch-package": "^8.0.1",
    "pkg": "^5.8.1",
    "resedit-cli": "^3.0.1"
  }
}
