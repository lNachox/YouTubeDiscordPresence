[Unit]
Description=YouTubeDiscordPresence (MPRIS to Discord RPC)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/ytdiscord/NodeHost
ExecStart=/usr/bin/node %h/.local/share/ytdiscord/NodeHost/src/app.js
Environment=YTDP_ENV_FILE=%h/.config/ytdiscord/ytdiscord.env
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
